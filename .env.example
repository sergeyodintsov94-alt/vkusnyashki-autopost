# Для запуска на своём компьютере: скопируйте в .env и заполните. Файл .env никому не отправляйте.
# На GitHub эти значения вводятся в Settings → Secrets, а не в файл.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Публичный адрес файлов репозитория (подставьте свой логин и название репозитория):
PUBLIC_BASE_URL=https://raw.githubusercontent.com/ЛОГИН/РЕПОЗИТОРИЙ/main
# Если вход через Instagram Login (а не через Facebook): GRAPH_HOST=https://graph.instagram.com
# GRAPH_HOST=https://graph.facebook.com
# GRAPH_VERSION=v21.0
